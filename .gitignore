# Terraform state — contains generated secrets in plaintext
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Terraform plan files — can embed sensitive values
*.tfplan
tf.plan

# Terraform working directory — provider binaries, regenerated by terraform init
.terraform/

# Real tfvars — keep only the .example template
terraform.tfvars
!terraform.tfvars.example

# Terraform crash logs
crash.log
crash.*.log

# Environment files — keep only .example templates
.env
.env.*
!.env.example

# Terraform output captures
Outputs.txt
outputs.txt

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.swp

systemd/
Detections/
detection/

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Docker overrides — often hold local secrets or port tweaks
docker-compose.override.yml
docker-compose.override.yaml

# Log files
*.log

# Backup files
*.bak
*.backup

# Secret files
secrets.yml
secrets.yaml
*.secret